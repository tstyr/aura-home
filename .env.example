APP_ORIGIN=https://YOUR-PROJECT.vercel.app
# true: every confirmed account gets an isolated workspace.
PUBLIC_SIGNUPS=true
# Optional private deployment restriction / legacy owner mapping.
OWNER_EMAIL=
# Legacy namespace applies ONLY to the verified OWNER_EMAIL account. Never shared.
APP_DATA_USER_ID=
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=aura-home
# Supabase shared transaction pooler (server only, URI-encoded password).
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=
# Derived from APP_ORIGIN if omitted.
GOOGLE_REDIRECT_URI=
# Enable only after Supabase's Google provider is configured.
GOOGLE_AUTH_ENABLED=false
