{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,
 "regions":["hnd1"],
 "installCommand":"npm ci",
 "buildCommand":"npm run build",
 "outputDirectory":"public",
 "functions":{"api/entry.js":{"maxDuration":60}},
 "rewrites":[{"source":"/","destination":"/api/entry?__aura_path=/"},{"source":"/:path*","destination":"/api/entry?__aura_path=/:path*"}],
 "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
}
