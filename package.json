{
  "name": "aura-home",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "db": "node --env-file-if-exists=.env.local scripts/db.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-legacy.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "fast-xml-parser": "5.11.2",
    "ical.js": "2.2.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@electric-sql/pglite": "0.5.8"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT"
}
